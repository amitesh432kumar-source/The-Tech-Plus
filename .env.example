# ── The Tech Plus — Environment Variables ──────────────────────────────────
# Copy this file to .env.local and fill in real values. Never commit secrets.

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (public — safe for the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase (server-only — NEVER expose to the client/browser bundle)
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay (server-only for the secret; key id may be exposed to the client)
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email provider (extensible — fill in once a provider is chosen, e.g. Resend)
EMAIL_FROM=notifications@thetechplus.com
RESEND_API_KEY=
