# ── The Tech Plus — Environment Variables ──────────────────────────────────
# Copy this file to .env.local and fill in real values. Never commit secrets.

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (public — safe for the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase (server-only — NEVER expose to the client/browser bundle)
SUPABASE_SERVICE_ROLE_KEY=

# PayPal (client ID is safe to expose to the browser; secret and webhook ID are server-only)
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# "sandbox" (default, for testing) or "live"
PAYPAL_MODE=sandbox
# 3-letter ISO currency PayPal will charge in — prices in the database are
# stored in this currency's smallest-unit-free decimal form (e.g. "499.00").
PAYPAL_CURRENCY=USD

# Email provider (extensible — fill in once a provider is chosen, e.g. Resend)
EMAIL_FROM=notifications@thetechplus.com
RESEND_API_KEY=
